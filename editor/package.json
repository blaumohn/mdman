{
  "name": "mdman-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node bin/serve.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.4",
    "mermaid": "^12.2.0",
    "react": "^18.3.1",
    "react-arborist": "^4.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
